# Kiddo Assist — environment example.
# Copy to `.env` and adjust. All values have safe defaults.
# (Windows note: running under Docker Desktop uses WSL2 for Compose.)

# Ollama thread count — set to the machine's physical cores (guide §10).
OLLAMA_NUM_THREADS=4

# Pinned Gemma model tag (guide §6.7).
GEMMA_TAG=gemma3:4b