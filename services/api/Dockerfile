# Kiddo Assist API service.
# Python 3.11 chosen for downstream ML wheel compatibility (faster-whisper, transformers).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]